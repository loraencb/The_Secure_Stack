SECURESTACK_APP_ENV=production
SECURESTACK_LOG_LEVEL=INFO

# Backend API
SECURESTACK_API_HOST=0.0.0.0
SECURESTACK_API_PORT=8000
SECURESTACK_API_WORKERS=1
SECURESTACK_CORS_ORIGINS=http://localhost:8080

# Database
POSTGRES_DB=securestack
POSTGRES_USER=securestack
POSTGRES_PASSWORD=change-this-postgres-password
SECURESTACK_DATABASE_URL=postgresql+psycopg://securestack:change-this-postgres-password@postgres:5432/securestack
SECURESTACK_DATABASE_CONNECT_RETRIES=10
SECURESTACK_DATABASE_CONNECT_RETRY_DELAY=2
SECURESTACK_RUN_MIGRATIONS_ON_STARTUP=1
SECURESTACK_AUTO_CREATE_SCHEMA=0

# Authentication
SECURESTACK_AUTH_TOKEN_SECRET=change-this-to-a-long-random-secret
SECURESTACK_AUTH_TOKEN_TTL_HOURS=24
SECURESTACK_INSTRUCTOR_EMAILS=ta@example.com
SECURESTACK_PASSWORD_ITERATIONS=120000
SECURESTACK_MIN_PASSWORD_LENGTH=8

# AI service
SECURESTACK_OLLAMA_URL=http://host.docker.internal:11434/api/generate
SECURESTACK_OLLAMA_MODEL=llama3
SECURESTACK_OLLAMA_TIMEOUT_SECONDS=60

# OpenAI deep tutor layer (backend only; never expose this key in frontend code)
OPENAI_TUTOR_ENABLED=1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_TIMEOUT_SECONDS=14
OPENAI_MAX_OUTPUT_TOKENS=700
OPENAI_REASONING_EFFORT=low
OPENAI_TEXT_VERBOSITY=low
OPENAI_ORG_ID=
OPENAI_PROJECT_ID=

# Docker / lab runtime
SECURESTACK_DOCKER_HOST=unix:///var/run/docker.sock
SECURESTACK_DOCKER_CLI=docker
SECURESTACK_DOCKER_COMPOSE_COMMAND=docker compose
SECURESTACK_CONTAINER_SHELL=bash
SECURESTACK_TARGET_READY_TIMEOUT_SECONDS=60
SECURESTACK_PULL_RUNTIME_IMAGES=1
SECURESTACK_TARGET_PUBLIC_HOST=localhost
SECURESTACK_TARGET_PROBE_HOST=host.docker.internal
SECURESTACK_CONTAINER_MEMORY_LIMIT=512m
SECURESTACK_CONTAINER_NANO_CPUS=1000000000

# Frontend build and exposed port
SECURESTACK_FRONTEND_PORT=8080
VITE_API_URL=/api
VITE_WS_URL=/ws
